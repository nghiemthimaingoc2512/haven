# Copy to .env.local for local development. On Vercel, add these under
# Project > Settings > Environment Variables.

# Required for the real Whisper / Aurora replies. Without it the app still
# runs, but falls back to the old keyword-based engine.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Model used for every companion reply and reflection.
# Default: claude-opus-5-5. Cheaper options: claude-sonnet-5-5, claude-haiku-5-5.
# HAVEN_AI_MODEL=claude-opus-5-5

# Optional. Public URL, used for Open Graph metadata.
# NEXT_PUBLIC_SITE_URL=https://havenmind-ai.vercel.app
